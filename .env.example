# Public canonical URL. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Explicit safety switch: disabled, test, or live.
# Live mode requires an sk_live_ key and a non-local HTTPS site URL.
# Switch to test only after replacing both Stripe placeholders below.
COMMERCE_MODE=disabled

# Stripe test-mode secrets. Never expose either value with a NEXT_PUBLIC_ prefix.
# Create test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and copy the whsec_ value printed by Stripe CLI.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
